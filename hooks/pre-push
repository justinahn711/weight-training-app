#!/bin/sh
# The gate.
#
# Branch protection is unavailable on this repo — private, free plan; the API
# returns 403 on /protection and /rulesets. So the thing that stops a broken
# push is local, and it has to be fast enough that nobody is tempted to skip
# it. The domain suite runs in about a second and a half precisely because Core
# imports Foundation only, so both checks below are cheap and the second one is
# what keeps the first one cheap.
#
# Wire it up ONCE PER CLONE, not per worktree:
#
#     git config core.hooksPath hooks
#
# Linked worktrees share .git/config, and the path is relative, so it resolves
# against each worktree's own top level. A branch predating hooks/ runs no hook
# at all rather than erroring — the one way this gate goes absent silently.
#
# --no-verify is blocked by a PreToolUse hook (hooks/block-gate-bypass.sh), not
# just the deny list, because permission patterns are prefix matches and the
# flag can be written last. If a check fails, fix the code — never the hook.

set -e

# Collect the refs being pushed.
#
# EVERY branch ref in the push must be HEAD, not merely one of them: the checks
# below test the working tree once, so `git push --all` or `git push origin
# HEAD other-branch` would otherwise carry one branch's green verdict onto an
# untested one. Deletions have nothing to test; tags point at a tag object that
# is never equal to HEAD, so requiring it of them would hard-fail every
# `git push --follow-tags` with advice that cannot help.
branches=0
all_are_head=1
head_sha=$(git rev-parse HEAD)
while read -r local_ref local_sha _remote_ref _remote_sha; do
    [ "$local_sha" = "0000000000000000000000000000000000000000" ] && continue
    case "$local_ref" in refs/tags/*) continue ;; esac
    branches=$((branches + 1))
    [ "$local_sha" = "$head_sha" ] || all_are_head=0
done
[ "$branches" -eq 0 ] && exit 0

root=$(git rev-parse --show-toplevel)
cd "$root"

# Everything below tests the WORKING TREE. That only describes what is being
# pushed if the pushed commit is HEAD and the tracked files are clean —
# otherwise a broken commit can ship green while its fix sits uncommitted, or
# one branch's result gets reported for another.
if [ "$all_are_head" = "0" ]; then
    printf '\n  FAIL — pushing a commit that is not HEAD.\n\n'
    printf '  This hook tests the checked-out tree, so it cannot speak to what\n'
    printf '  you are pushing. Check out the branch (or push from its worktree)\n'
    printf '  and try again.\n\n'
    exit 1
fi

if ! git diff --quiet HEAD 2>/dev/null; then
    printf '\n  FAIL — tracked files are modified.\n\n'
    printf '  The suite would test your working tree, not the commit being\n'
    printf '  pushed, so a broken commit can pass here while its fix sits\n'
    printf '  uncommitted. Commit or stash first. (Untracked files are fine.)\n\n'
    git diff --name-only HEAD | sed 's/^/    /'
    printf '\n'
    exit 1
fi

printf '\npre-push: Core imports Foundation only... '
if ! purity=$(sh "$root/hooks/check-core-purity.sh" 2>&1); then
    printf 'FAIL\n\n'
    printf '%s\n\n' "$purity"
    exit 1
fi
printf 'ok\n'

printf 'pre-push: swift test... '
if ! output=$(swift test 2>&1); then
    printf 'FAIL\n\n'
    printf '%s\n' "$output" | grep -E 'error:|failed|XCTAssert|Test Case.*failed' | head -30
    printf '\n  Full output: swift test\n\n'
    exit 1
fi

# Count the tests that actually ran, and refuse to call zero a pass.
#
# Don't tail the output. `swift test` ends with the swift-testing runner's
# summary, which today reads "0 tests in 0 suites" because every test here is
# XCTest — tailing it makes a full green suite look like nothing ran, the exact
# failure this hook exists to catch.
#
# Both runners are linked, so count both, and match the singular forms too:
# XCTest writes "Executed 1 test" and swift-testing "Test run with 1 test",
# so a plural-only pattern reports a green one-test suite as zero.
xctest=$(printf '%s\n' "$output" \
    | grep -A1 "Test Suite 'All tests' passed" \
    | grep -oE 'Executed [0-9]+ tests?' | grep -oE '[0-9]+' | tail -1)
swifttesting=$(printf '%s\n' "$output" \
    | grep -oE 'Test run with [0-9]+ tests?' | grep -oE '[0-9]+' | tail -1)
count=$(( ${xctest:-0} + ${swifttesting:-0} ))

if [ "$count" -eq 0 ]; then
    printf 'FAIL\n\n'
    printf '  swift test exited 0 but reported no tests. That is not a pass.\n'
    printf '  Either the target list in Package.swift is wrong, or the output\n'
    printf '  format changed and this hook can no longer read it — check\n'
    printf '  `swift test` by hand before pushing.\n\n'
    exit 1
fi
printf 'ok — %s tests\n\n' "$count"
exit 0
