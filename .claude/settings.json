{
  "permissions": {
    "allow": [
      "Bash(swift build:*)",
      "Bash(swift test:*)",
      "Bash(swift package:*)",
      "Bash(xcodebuild:*)",
      "Bash(xcrun:*)",
      "Bash(open -a Simulator)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git fetch:*)",
      "Bash(git pull:*)",
      "Bash(git push:*)",
      "Bash(git stash:*)",
      "Bash(git cherry-pick:*)",
      "Bash(git restore:*)",
      "Bash(git rev-parse:*)",
      "Bash(git worktree add:*)",
      "Bash(git worktree list:*)",
      "Bash(git config core.hooksPath hooks)",
      "Bash(gh pr:*)",
      "Bash(gh issue:*)",
      "Bash(gh run:*)",
      "Bash(gh workflow:*)",
      "Bash(gh repo view:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(sed:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(find:*)",
      "Bash(wc:*)",
      "Bash(stat:*)",
      "Bash(date:*)",
      "Bash(diff:*)",
      "Bash(mkdir:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",
      "Bash(python3:*)",
      "Bash(plutil:*)",
      "Bash(sqlite3:*)",
      "Bash(codesign:*)",
      "Bash(nm:*)",
      "Bash(security find-identity:*)",
      "Bash(networksetup -getairportpower:*)",
      "Bash(curl -s -o /dev/null:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(git rebase:*)",
      "Bash(gh repo delete:*)",
      "Bash(gh release:*)",
      "Bash(rm -rf:*)",
      "Bash(sudo:*)",
      "Bash(defaults write:*)",
      "Bash(networksetup -setairportpower:*)",
      "Bash(git push --no-verify:*)",
      "Bash(git commit --no-verify:*)",
      "Bash(gh pr merge:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PROJECT_DIR:-.}/hooks/block-gate-bypass.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
